{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hydroponics-jma-weather",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  "workers_dev": true,
  "assets": {
    "directory": "../docs",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "HYDROPONICS_DB",
      "database_name": "hydroponics",
      "database_id": "d07738cc-cf73-48ec-b7c2-9cbd5d1de89f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "JOURNAL_PHOTOS",
      "bucket_name": "hydroponics-journal-photos"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
